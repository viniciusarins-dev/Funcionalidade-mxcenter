# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA coloque o .env de verdade no Git.

# ============================================================
# 1) LOGIN NO WTTI — preencha primeiro, é o mínimo pra testar
# ============================================================
WTTI_USER=seu_usuario
WTTI_PASS=sua_senha
WTTI_BASE_URL=https://mxcenter.wtti.app
WTTI_LOGIN_URL=https://mxcenter.wtti.app/Login.aspx
WTTI_SEARCH_URL=https://mxcenter.wtti.app/View/Cadastro/Notas.aspx

# ============================================================
# 2) SELETORES — já validados de ponta a ponta (login + busca) em
#    2026-08-11 com testar_login.py / testar_busca.py. Só reajuste se
#    o WTTI mudar de layout (veja GUIA_SELETORES.md nesse caso).
# ============================================================

# --- Tela de LOGIN ---
SEL_LOGIN_USERNAME=#txtUsuario
SEL_LOGIN_PASSWORD=#txtSenha
SEL_LOGIN_SUBMIT=#btnAcessar
SEL_LOGIN_SUCESSO=#lblTelefone

# --- Tela de CONSULTA DE NOTA ---
SEL_BUSCA_INPUT=#ctl00_ContentPlaceHolder1_pesquisaApplet_ctl03_txtValor
SEL_BUSCA_SUBMIT=#btnConsultar
SEL_RESULTADO_IFRAME=

# Filtro "Tipo de Documento" (dropdown de checkboxes) — precisa estar
# marcado em "Nota Fiscal Eletrônica de Saída" pra busca retornar linhas.
SEL_TIPO_DOC_DROPDOWN=#ctl00_ContentPlaceHolder1_pesquisaApplet_ctl02_ddlValor_sl
SEL_TIPO_DOC_CHECKBOX=#ctl00_ContentPlaceHolder1_pesquisaApplet_ctl02_ddlValor_14

# Grid de resultados da busca (gdwNotas) — escolhe a linha pelo texto da
# coluna "Tipo" e clica no botão Selecionar dela.
SEL_TABELA_NOTAS=#gdwNotas
TIPO_NOTA_DESEJADO=Nota Fiscal Eletrônica de Saída

SEL_CLIENTE_NOME=#txtRazaoSocial
SEL_NUMERO_NF=#txtNF
SEL_TABELA_ITENS=#gdwProduto
SEL_LINHAS_ITENS=#gdwProduto tbody tr
COL_CODIGO=0
COL_PRODUTO=1
COL_QTD=2

# Galeria de imagens do produto (CadastroProduto.aspx?UID=<codigo>)
SEL_GALERIA_ITEM=.galeriaImagens .galleryItem

# ============================================================
# 2.1) SELETORES — sidebar de reposição (AINDA NÃO VALIDADOS,
#      são só um palpite — veja GUIA_SELETORES.md, Passo 7)
# ============================================================

# --- Relatório de Ranking de Produtos (saída do mês) ---
WTTI_RANKING_URL=https://mxcenter.wtti.app/View/Relatorio/RelatorioRankingProdutos.aspx
SEL_RANKING_MES_INPUT=
SEL_RANKING_SUBMIT=
SEL_RANKING_TABELA=#gdwRanking
SEL_RANKING_LINHAS=#gdwRanking tbody tr
COL_RANKING_CODIGO=0
COL_RANKING_QTD=1

# --- Manutenção de Estoque por Filial (validado em 2026-08-11) ---
WTTI_ESTOQUE_URL=https://mxcenter.wtti.app/View/Cadastro/ManutencaoEstoqueFilial.aspx
SEL_ESTOQUE_BUSCA_INPUT=#txtCodProduto
SEL_ESTOQUE_BUSCA_SUBMIT=#btnPesquisa
SEL_ESTOQUE_TABELA=#gdwVendas
SEL_ESTOQUE_LINHAS=#gdwVendas tbody tr
COL_ESTOQUE_CODIGO=0
COL_ESTOQUE_QTD=2

# ============================================================
# 3) API — pode deixar como está pra testar localmente
# ============================================================
API_KEY=
CORS_ORIGINS=*
CACHE_TTL_SECONDS=300
PORT=5000
HEADLESS=true
EXPLICIT_WAIT_SECONDS=15
IMPLICIT_WAIT_SECONDS=0
