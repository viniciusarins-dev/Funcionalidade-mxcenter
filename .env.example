# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA coloque o .env de verdade no Git.

# ============================================================
# 1) LOGIN NO WTTI — preencha primeiro, é o mínimo pra testar
# ============================================================
WTTI_USER=seu_usuario
WTTI_PASS=sua_senha
WTTI_BASE_URL=https://mxcenter.wtti.app
WTTI_LOGIN_URL=https://mxcenter.wtti.app/Login.aspx
WTTI_SEARCH_URL=https://mxcenter.wtti.app/ConsultaNota.aspx

# ============================================================
# 2) SELETORES — preencha DEPOIS de inspecionar o HTML real
#    do WTTI com o DevTools (F12). Os valores abaixo são só
#    exemplo/placeholder e quase certamente estão errados.
# ============================================================

# --- Tela de LOGIN ---
SEL_LOGIN_USERNAME=#txtUsuario
SEL_LOGIN_PASSWORD=#txtSenha
SEL_LOGIN_SUBMIT=#btnEntrar
SEL_LOGIN_SUCESSO=#menuPrincipal

# --- Tela de CONSULTA DE NOTA ---
SEL_BUSCA_INPUT=#ctl00_ContentPlaceHolder1_pesquisaApplet_ctl03_txtValor
SEL_BUSCA_SUBMIT=#btnConsultar
SEL_RESULTADO_IFRAME=

# Filtro "Tipo de Documento" (dropdown de checkboxes) — precisa estar
# marcado em "Nota Fiscal Eletrônica de Saída" pra busca retornar linhas.
SEL_TIPO_DOC_DROPDOWN=#ctl00_ContentPlaceHolder1_pesquisaApplet_ctl02_ddlValor_sl
SEL_TIPO_DOC_CHECKBOX=#ctl00_ContentPlaceHolder1_pesquisaApplet_ctl02_ddlValor_14

# Grid de resultados da busca (gdwNotas) — escolhe a linha pelo texto da
# coluna "Tipo" e clica no botão Selecionar dela.
SEL_TABELA_NOTAS=#gdwNotas
TIPO_NOTA_DESEJADO=Nota Fiscal Eletrônica de Saída

SEL_CLIENTE_NOME=#txtRazaoSocial
SEL_NUMERO_NF=#txtNF
SEL_TABELA_ITENS=#gdwProduto
SEL_LINHAS_ITENS=#gdwProduto tbody tr
COL_CODIGO=0
COL_PRODUTO=1
COL_QTD=2

# Galeria de imagens do produto (CadastroProduto.aspx?UID=<codigo>)
SEL_GALERIA_ITEM=.galeriaImagens .galleryItem

# ============================================================
# 3) API — pode deixar como está pra testar localmente
# ============================================================
API_KEY=
CORS_ORIGINS=*
CACHE_TTL_SECONDS=300
PORT=5000
HEADLESS=true
EXPLICIT_WAIT_SECONDS=15
IMPLICIT_WAIT_SECONDS=0
